  "learning": {
    "question": "export-series는 스펙을 어떻게 검증해 시리즈로 게시하는가?",
    "answer": "`exportSeries`는 모든 스펙을 먼저 검증하고, 통과했을 때만 임시 트리에 노트·SVG·Excalidraw·`manifest.json`을 만들어 한 번에 게시한다. 검증은 `readSpecs`가 맡아 `parseVisualNoteSpec` 파싱, 파일명과 `artifactId` 일치, fact의 `resolveEvidence`, 정렬과 중복을 확인한다. 게시는 `publishProjectDirectory`가 맡아 새 대상은 `CREATED`, 같은 내용은 `ALREADY_CURRENT`로 끝내고, 내용이 다른 대상에는 `CollisionError`를 던진다.",
    "route": [
      {
        "semanticId": "input-directories",
        "explanation": "`realDirectory`가 입력 경로가 정규화된 절대 경로이고 실제 디렉터리인지 확인한다. 스펙을 읽기 전에 저장소와 스펙 폴더의 위치를 확정한다."
      },
      {
        "semanticId": "validated-specs",
        "explanation": "`readSpecs`가 스펙 JSON을 파싱하고 파일명 규칙과 fact 증거를 확인한다. `resolveEvidence`는 증거 파일의 존재, 지정된 줄 범위와 심볼 문자열을 검사한다."
      },
      {
        "semanticId": "ordered-series",
        "explanation": "종류를 `kindOrder` 순서로 정렬하고, 동률은 `artifactId` 문자열 순으로 정렬한다. 스펙 폴더가 비어 있거나 `artifactId`가 중복되면 거부한다."
      },
      {
        "semanticId": "staging-project",
        "explanation": "`sessionRoot` 아래에 임시 루트를 만들고 그 안의 `project` 폴더를 스테이징 대상으로 쓴다. 게시가 끝나면 `finally`에서 임시 루트를 제거한다."
      },
      {
        "semanticId": "rendered-series",
        "explanation": "`indexFor`와 `noteFor`가 시리즈 홈과 개별 노트를 구성한다. `learningHeader`, `learningIndexLines`, `learningSections`는 learning 필드가 있을 때 내용을 반영한다. 각 스펙의 미리보기는 `renderViewSvg`로, 편집 원본은 `sceneFromSpec`→`encodeSceneToMarkdown`으로 만든다."
      },
      {
        "semanticId": "hashed-manifest",
        "explanation": "`manifest`는 시리즈 메타데이터와 생성 파일 목록을 담고, 각 기존 파일 바이트의 `sha256`을 기록한다. 매니페스트 자체는 해시 목록을 만들 때 `files`에 포함되지 않는다."
      },
      {
        "semanticId": "published-project",
        "explanation": "`publishProjectDirectory`가 스테이징 디렉터리를 `docs/vl/projects/<project>`로 이동한다. 대상이 이미 있으면 파일 목록과 각 파일 해시를 비교해 동일 여부를 판별한다."
      },
      {
        "semanticId": "collision-error",
        "explanation": "대상이 심볼릭 링크이거나 디렉터리가 아니면, 또는 스테이징 트리와 내용이 다르면 `CollisionError`를 던진다. 기존 파일을 덮어쓰지 않고 충돌로 중단한다."
      }
    ],
    "glossary": [
      {
        "term": "realDirectory",
        "meaning": "정규 절대 비루트 경로와 실제 디렉터리 여부를 확인해 `realpath`를 반환하는 함수다."
      },
      {
        "term": "readSpecs",
        "meaning": "대상 JSON 스펙을 파싱·검증하고 종류와 `artifactId`를 기준으로 정렬하는 함수다."
      },
      {
        "term": "resolveEvidence",
        "meaning": "증거 경로의 실제 파일 존재 여부와 선택적 줄 범위·심볼 참조를 확인하는 함수다."
      },
      {
        "term": "manifest",
        "meaning": "프로젝트와 아티팩트 정보, 산출 파일별 SHA-256을 기록하는 JSON 데이터다."
      },
      {
        "term": "publishProjectDirectory",
        "meaning": "스테이징 디렉터리를 새 경로에 게시하거나 기존 디렉터리와 같은지 비교하는 함수다."
      }
    ],
    "scope": {
      "covers": [
        "입력 디렉터리와 스펙 파일을 검증·정렬한다.",
        "learning 노트, SVG, Excalidraw 원본을 스테이징한다.",
        "파일별 SHA-256 매니페스트를 만들고 게시 결과를 분기한다."
